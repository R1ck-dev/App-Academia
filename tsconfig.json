{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Os testes de domínio rodam no `node --test`, que faz type stripping nativo
    // e por isso exige a extensão .ts explícita no import.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "drizzle"]
}
